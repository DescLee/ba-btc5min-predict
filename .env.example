# 默认 BTC 真实现货行情 + 模拟预测盘口和交易，不请求账户、不动用真实资金。
MODE=demo
BTC_PRICE_MODE=live
PORT=4317
BINANCE_API_KEY=
BINANCE_API_SECRET=
# 多个预测钱包时必须显式填写；只有一个钱包时自动识别。
BINANCE_WALLET_ADDRESS=
BINANCE_WALLET_ID=
FUNDING_SOURCE=MPC
ACCOUNT_TYPE=SPOT
# 只读接入用 MODE=live；以下开关仍为 false。
LIVE_TRADING_ENABLED=false
# 核对 App 与 API 目标价、方向、截止时间及结算规则后才能设置 true。
MARKET_RULES_VERIFIED=false
# 仅当本产品的价格来源确认是 BINANCE BTCUSDT 现货时选 BINANCE_SPOT。
# 未验证的参考价只用于展示，不能触发真实交易。
SETTLEMENT_PRICE_SOURCE=UNVERIFIED
MAX_ORDER_USDT=20
MAX_DAILY_USDT=100
MIN_REMAINING_SECONDS=5
MAX_DATA_AGE_MS=5000
POLL_INTERVAL_MS=2500
# 默认使用系统 jev 命令；也可填写本机技能中的 scripts/jev 绝对路径。
JEV_COMMAND=jev
JEV_TIMEOUT_MS=2000
JEV_MIN_CONFIDENCE=0.8
